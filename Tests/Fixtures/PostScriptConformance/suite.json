        "solid": {"rasterDigests":["1eee441e7cfe8212045a8cc94ba17e450c0c9ca2c15885db68af6638ce5c8fe1"]},
        "reference": {"rasterDigests":["922fba9dd89fa1a11c02b63cac04c5bfccc094ea50b99446f1bf5195c5042bcf"]},
        "referenceVersion": "10.07.1",
        "rationale": "The paired recording case pins identical shared-edge path construction and painting order. PLRM 6.1 leaves pixel scan conversion device-dependent, so the exact low-resolution antialias coverage is retained as a fixture-local difference rather than widening raster tolerances."
      }
