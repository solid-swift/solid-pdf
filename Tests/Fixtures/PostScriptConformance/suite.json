      "expectation": {
        "solid": {"transcript":"Expected/errors.transcript"},
        "reference": {"transcript":"Expected/errors.ghostscript-10.07.1.transcript"},
        "referenceVersion": "10.07.1",
        "rationale": "PLRM 3.11.1 requires restoration to the operand stack state before the failing object and then pushes that object; Ghostscript omits one resulting stack entry after stopped catches div."
