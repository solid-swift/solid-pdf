#!/usr/bin/env bash

set -euo pipefail

ROOT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
for tool in qpdf mutool; do
  if ! command -v "${tool}" >/dev/null 2>&1; then
    echo "error: ${tool} is required for PDF security interoperability validation" >&2
    exit 69
  fi
done

WORK_DIRECTORY="$(mktemp -d "${TMPDIR:-/tmp}/solidpdf-security-interop.XXXXXX")"
trap 'rm -rf "${WORK_DIRECTORY}"' EXIT

cd "${ROOT_DIRECTORY}"
BENCHMARK_ENABLE=1 swift run --disable-automatic-resolution \
  --scratch-path "${SOLIDPDF_SCRATCH_PATH:-.build}" \
  SolidPDFInteropFixtures create "${WORK_DIRECTORY}/source"
Scripts/generate-pdf-security-oracles \
  "${WORK_DIRECTORY}/source/writer-1.7.pdf" \
  "${WORK_DIRECTORY}/encrypted"

for input in "${WORK_DIRECTORY}"/encrypted/*.pdf; do
  BENCHMARK_ENABLE=1 swift run --disable-automatic-resolution \
    --scratch-path "${SOLIDPDF_SCRATCH_PATH:-.build}" \
    SolidPDFInteropFixtures verify-security "${input}" user
  qpdf --password=user --check "${input}"
  qpdf --password=user --show-object=4 --filtered-stream-data "${input}" \
    >"${WORK_DIRECTORY}/qpdf-stream"
  cmp "${WORK_DIRECTORY}/qpdf-stream" <(printf '0 0 m 72 72 l S\n')
  mutool show -p user "${input}" trailer/Root/Pages/Kids/0/Contents >/dev/null
done
